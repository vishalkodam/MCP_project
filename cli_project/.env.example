# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model ID, e.g. claude-sonnet-5 (balanced), claude-opus-5 (most capable),
# claude-haiku-4-5 (fastest/cheapest). See https://docs.anthropic.com/en/docs/about-claude/models
CLAUDE_MODEL=claude-sonnet-5

# Directory the document server reads from (default: ./docs next to mcp_server.py)
# DOCS_DIR=/path/to/your/documents

# Optional: reach the document server over Streamable HTTP instead of stdio.
# Start it with: python mcp_server.py --transport http --port 8000
# MCP_TRANSPORT=http
# MCP_SERVER_URL=http://localhost:8000/mcp
